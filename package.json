    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.9.6",
    "lucide-svelte": "^0.563.0",
    "resend": "^3.2.0",
    "tailwind-merge": "^3.4.0",
    "yup": "^1.4.0"
