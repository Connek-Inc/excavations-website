# ===== MySQL — Hostinger Database credentials =====
# Get these from Hostinger panel → Databases → Management
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u274996454_excerable
DB_USER=u274996454_excerable
DB_PASSWORD=your-strong-password

# ===== JWT Secret =====
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-output-min-32-chars

# ===== Web3Forms (email notification on new lead) =====
# Free at https://web3forms.com (no signup required)
WEB3FORMS_KEY=your-web3forms-access-key-here

# ===== Resend (transactional emails on every soumission) =====
# Free 100/day at https://resend.com
RESEND=re_xxxxxxxxxx
EMAIL_FROM="Mini Excavations Érable <onboarding@resend.dev>"
# Where lead notifications go
ADMIN_EMAIL=miniexcavationerable@gmail.com

# ===== Initial admin user (used by db/seed.sql) =====
SEED_ADMIN_EMAIL=miniexcavationerable@gmail.com
SEED_ADMIN_PASSWORD=your-strong-admin-password
SEED_ADMIN_NAME=Admin Mini Excavations Érable

# ===== Node.js runtime =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Comma-separated list; empty means same origin only.
ALLOWED_ORIGINS=https://excavationserable.com

# ===== Frontend (PUBLIC_*) =====
PUBLIC_API_BASE=
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== Connek API integration =====
# All quote submissions are forwarded to connek-api. Server-only — never
# expose these to the browser.
CONNEK_API_BASE_URL=https://connek-dev-aa5f5db19836.herokuapp.com
CONNEK_API_KEY_ID=ck_live_xxxxxxxxxxxxxxxxxxxxxx
CONNEK_API_KEY_SECRET=ck_sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
