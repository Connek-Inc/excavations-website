# ===== Node.js runtime =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===== Frontend (PUBLIC_*) — exposed to the browser =====
PUBLIC_API_BASE=
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== Connek API integration (server-only) =====
# Consumed exclusively by SvelteKit server routes (src/lib/server/connek/).
# Never expose to the browser. HMAC signing happens server-side.
CONNEK_API_BASE_URL=https://api.dev.connek.ca
CONNEK_API_KEY_ID=ck_live_xxxxxxxxxxxxxxxxxxxxxx
CONNEK_API_KEY_SECRET=ck_sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
