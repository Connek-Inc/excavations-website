# ===== Node.js runtime =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===== Frontend (PUBLIC_*) — exposed to the browser =====
PUBLIC_API_BASE=
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== Connek API integration (server-only) =====
# Consumed exclusively by Express (server.js). Never expose to the browser.
# HMAC signing happens server-side.
#
# api.connek.ca expone /api/v1/* con HMAC directo (la URL que ya funciona).
# api.dev.connek.ca tiene un Kong/gateway adelante que pide otra forma de
# auth — no usable con la key Connek tal cual.
CONNEK_API_BASE_URL=https://api.connek.ca
CONNEK_API_KEY_ID=ck_live_xxxxxxxxxxxxxxxxxxxxxx
CONNEK_API_KEY_SECRET=ck_sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Fallback email sender (Resend) =====
# Same Resend key as connek-workers. excavations re-sends submission emails
# when connek-workers can't deliver them after its retries.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret — MUST match FALLBACK_SHARED_SECRET in connek-workers.
FALLBACK_SHARED_SECRET=change-me-to-a-long-random-string
FALLBACK_FROM=Connek <team@connek.ca>

# Excavations sends submission notifications directly (emergency path).
BUSINESS_NAME=Mini Excavations Érable
BUSINESS_NOTIFY_EMAIL=business@example.com
