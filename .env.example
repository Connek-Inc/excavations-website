# ===== MySQL — Hostinger Database credentials =====
# Get these from Hostinger panel → Databases → Management
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u274996454_excerable
DB_USER=u274996454_excerable
DB_PASSWORD=your-strong-password

# ===== JWT Secret =====
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-output-min-32-chars

# ===== Web3Forms (email notification on new lead) =====
# Free at https://web3forms.com (no signup required)
WEB3FORMS_KEY=your-web3forms-access-key-here

# ===== Resend (password reset + soumission notifications) =====
# Free 100/day at https://resend.com
RESEND=re_xxxxxxxxxx
EMAIL_FROM="Mini Excavations Érable <onboarding@resend.dev>"

# ===== Initial admin user =====
# Used by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@excavationserable.com
SEED_ADMIN_PASSWORD=your-strong-admin-password
SEED_ADMIN_NAME=Admin Mini Excavations Érable

# ===== Node.js runtime =====
NODE_ENV=production
PORT=3000
ORIGIN=https://excavationserable.com
HOST=0.0.0.0
