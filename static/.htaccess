# Hostinger / Apache config for SvelteKit static export
# Serves /urgences as /urgences.html, /services/drain-francais as /services/drain-francais.html, etc.

RewriteEngine On

# 0. Force www OR non-www canonical (we choose non-www → SEO consistency)
RewriteCond %{HTTP_HOST} ^www\.excavationserable\.com$ [NC]
RewriteRule ^(.*)$ https://excavationserable.com/$1 [L,R=301]

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Remove trailing slash from URLs (canonical: /services NOT /services/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# 3. If a clean URL like /urgences exists as /urgences.html, serve it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# 3b. Same for old domain redirects (mini... → main domain)
RewriteCond %{HTTP_HOST} ^miniexcavationserable\.com$ [NC]
RewriteRule ^(.*)$ https://excavationserable.com/$1 [L,R=301]

# 4. Custom 404 page (SvelteKit fallback)
ErrorDocument 404 /404.html

# ─────────────────────────────────────────────
# CACHING — Aggressive caching for static assets
# ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Images (1 year)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Videos (1 month)
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"

  # Fonts (1 year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS / JS (1 month — they have hashes in filenames)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML (1 hour — to allow updates to propagate)
  ExpiresByType text/html "access plus 1 hour"

  # XML / Sitemap (1 hour)
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# ─────────────────────────────────────────────
# COMPRESSION — Gzip / Brotli
# ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/woff2
</IfModule>

# ─────────────────────────────────────────────
# SECURITY HEADERS
# ─────────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS — force HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Security
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # CORS for fonts
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ─────────────────────────────────────────────
# MIME types (critical for sitemap.xml + webp)
# ─────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/webp .webp
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

# ─────────────────────────────────────────────
# Disable directory browsing
# ─────────────────────────────────────────────
Options -Indexes
